  },
  "applications": [
    { "id": "SumatraPDF.SumatraPDF", "name": "SumatraPDF" },
    { "id": "Notepad++.Notepad++", "name": "Notepad++" },
    { "id": "WinSCP.WinSCP", "name": "WinSCP" },
    { "id": "TheDocumentFoundation.LibreOffice", "name": "LibreOffice" },
    { "id": "LibreCAD.LibreCAD", "name": "LibreCAD", "required": false }
  ],
  "printers": [
    { "name": "Taller - Impresora de planta", "address": "192.168.50.20", "driver": "HP Universal Printing PCL 6", "driverInf": "\\\\srv-files\\drivers\\hp-upd-pcl6\\hpcu270u.inf", "location": "Nave 2" }
  ],
  "security": {
