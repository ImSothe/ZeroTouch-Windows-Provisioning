      "rules": [
        { "displayName": "ZT - Allow DNC from the machine network", "direction": "Inbound", "action": "Allow", "protocol": "TCP", "localPort": "5001", "remoteAddress": "192.168.50.0/24", "profile": "Domain,Private" }
      ]
    }
  }
