{
  "$schema": "./schema/profile.schema.json",
  "name": "taller",
  "displayName": "Taller",
  "description": "Puesto de planta: planos, programas CNC y transferencia de ficheros a las máquinas.",
  "extends": "base",
  "removeApplications": [ "Adobe.Acrobat.Reader.64-bit" ],
